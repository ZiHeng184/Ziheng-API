{
  "name": "ziheng-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "pnpm build && wrangler dev",
    "start": "node scripts/preview-server.mjs",
    "dev:ui": "vite",
    "dev:worker": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ziheng-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ziheng-db --remote"
  },
  "dependencies": {
    "hono": "^4.11.7",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260309.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "wrangler": "^4.162.0"
  }
}
